{
  "name": "kumiko-panel",
  "version": "0.14.0",
  "private": true,
  "description": "Modular 3D-printed kumiko lattice wall panels: tiles snap into a wall-mounted frame, glue-free, sized for a 256 x 256 mm bed.",
  "license": "UNLICENSED",
  "scripts": {
    "generate": "node cli/generate.js",
    "test-kit": "node cli/generate.js --test-kit --out out/test-kit",
    "accessories": "node cli/accessories.js out/accessories",
    "kit": "node cli/test-kit-3mf.js out/living-lattice-test-kit.3mf",
    "build-site": "node cli/build-site.js",
    "cell-coupon": "node cli/cell-coupon.js out/cell-coupon",
    "test": "node --test test/*.test.js",
    "serve": "npx --yes http-server -c-1 -p 8080 ."
  },
  "engines": { "node": ">=18" }
}
